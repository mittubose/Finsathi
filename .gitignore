private_user_data_backup.tar.gz
*.tar.gz
*.zip
*.7z
*.rar
ref/
doc_content.txt
*.xlsx
*.xls
*.csv
*.pdf

# Environment & Secret Files (API Keys & Credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*
**/server/data/
**/server_auth.json

# Dependencies & Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
.cache/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Docker Volumes & Runtime Data
open-webui_data/
n8n_data/
memos_data/
*.sqlite
*.sqlite-journal
*.db

# IDE & Editor Settings
.vscode/
!.vscode/extensions.json
